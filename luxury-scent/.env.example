# ------------------------------------------------------------------
# Luxury Scent — variables d'environnement
# En production (Netlify) : à saisir dans Site configuration → Environment variables.
# En local : copier ce fichier en `.env`. Ne jamais committer `.env`.
# Guide complet : docs/04-netlify-supabase.md
# ------------------------------------------------------------------

# --- Supabase : base PostgreSQL ---------------------------------------------
# Runtime (pooler « Transaction », port 6543) — ajouter ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations (pooler « Session », port 5432)
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# --- Supabase : stockage des médias ------------------------------------------
# Laisser vide en local : les fichiers vont dans ./storage/uploads.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""          # clé publique (« anon ») : sert uniquement aux envois signés
SUPABASE_SERVICE_ROLE_KEY=""  # SECRÈTE : serveur uniquement, jamais exposée au navigateur

# --- Application ---------------------------------------------------------------
APP_URL="http://localhost:3000"          # URL publique, sans / final
SESSION_SECRET=""                        # openssl rand -hex 32
BANK_ENCRYPTION_KEY=""                   # openssl rand -hex 32 — à sauvegarder : sa perte rend les IBAN illisibles
UPLOAD_DIR="./storage/uploads"           # développement local uniquement

# Compte propriétaire créé au premier déploiement s'il n'existe aucun propriétaire.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""                        # 10 caractères minimum ; à retirer après la première connexion

# Catalogue de démonstration (1 = créer des produits « démo » supprimables en un clic)
SEED_DEMO=""

# --- Paiement Stripe (cartes + Apple Pay) -------------------------------------
STRIPE_SECRET_KEY=""                     # sk_live_… ou sk_test_…
STRIPE_WEBHOOK_SECRET=""                 # whsec_… (endpoint /api/stripe/webhook)

# --- E-mails (SMTP) — vide : e-mails journalisés dans l'admin mais non envoyés ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Luxury Scent <contact@example.com>"
