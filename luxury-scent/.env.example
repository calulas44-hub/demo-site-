# ------------------------------------------------------------------
# Luxury Scent — variables d'environnement
# Copier ce fichier en `.env` et remplir les valeurs. Ne jamais committer `.env`.
# ------------------------------------------------------------------

# Base de données.
# Développement : SQLite (fichier local). Production : PostgreSQL conseillé
# (voir docs/03-deploiement.md pour la bascule).
DATABASE_URL="file:./storage/luxury-scent.db"

# URL publique du site (sans barre oblique finale). Sert aux e-mails,
# aux redirections de paiement et aux métadonnées.
APP_URL="http://localhost:3000"

# Clé de signature des sessions (admin et clients). 32 octets minimum.
# Générer : openssl rand -hex 32
SESSION_SECRET=""

# Clé de chiffrement des coordonnées bancaires (AES-256-GCM). 32 octets en hexadécimal.
# Générer : openssl rand -hex 32
# ATTENTION : si cette clé est perdue, les IBAN stockés deviennent illisibles.
BANK_ENCRYPTION_KEY=""

# Dossier des fichiers téléversés (images produits, logo, reçus).
UPLOAD_DIR="./storage/uploads"

# Paiement par carte (Stripe Checkout). Laisser vide pour désactiver le paiement par carte :
# le virement bancaire reste disponible.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# E-mails transactionnels (SMTP). Laisser vide : les e-mails sont journalisés
# dans l'administration mais non envoyés.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Luxury Scent <contact@example.com>"

# Compte administrateur initial, créé par `npm run db:seed` s'il n'existe pas.
ADMIN_EMAIL="admin@luxury-scent.local"
ADMIN_PASSWORD="change-me-now"
