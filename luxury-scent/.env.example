# ------------------------------------------------------------------
# Luxury Scent — variables d'environnement
# En production (Netlify) : Site configuration → Environment variables.
#   La base (NETLIFY_DB_URL) et le stockage des médias (Netlify Blobs) sont fournis
#   automatiquement par Netlify : rien à saisir pour eux.
# En local : copier ce fichier en `.env`. Ne jamais committer `.env`.
# Guide complet : docs/04-netlify.md
# ------------------------------------------------------------------

# --- Base PostgreSQL (développement local uniquement) ---------------------------
DATABASE_URL="postgresql://postgres@localhost:5432/luxury"
DIRECT_URL="postgresql://postgres@localhost:5432/luxury"

# --- Application ---------------------------------------------------------------
APP_URL="http://localhost:3000"          # URL publique, sans / final
SESSION_SECRET=""                        # 64 caractères aléatoires (openssl rand -hex 32)
BANK_ENCRYPTION_KEY=""                   # 64 caractères hexadécimaux — à sauvegarder : sa perte rend les IBAN illisibles
UPLOAD_DIR="./storage/uploads"           # médias en développement local

# Compte propriétaire créé au premier déploiement s'il n'existe aucun propriétaire.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""                        # 10 caractères minimum ; à retirer après la première connexion

# Catalogue de démonstration (1 = produits « démo » supprimables en un clic)
SEED_DEMO=""

# --- Paiement Stripe (cartes + Apple Pay) -------------------------------------
STRIPE_SECRET_KEY=""                     # sk_live_… ou sk_test_…
STRIPE_WEBHOOK_SECRET=""                 # whsec_… (endpoint /api/stripe/webhook)

# --- E-mails (SMTP) — vide : e-mails journalisés dans l'admin mais non envoyés ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Luxury Scent <contact@example.com>"
