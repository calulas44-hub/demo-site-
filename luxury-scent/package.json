{
  "name": "luxury-scent",
  "version": "0.1.0",
  "private": true,
  "description": "Luxury Scent — boutique de parfumerie en ligne avec espace administrateur",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "tsx tests/run.ts",
    "vitrine:export": "tsx scripts/export-vitrine.ts",
    "build:netlify": "bash scripts/netlify-build.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "jose": "6.2.17",
    "next": "15.5.29",
    "nodemailer": "10.5.0",
    "pdfkit": "0.20.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sanitize-html": "2.18.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@netlify/plugin-nextjs": "^5.16.6",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "22.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "playwright": "^1.63.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
