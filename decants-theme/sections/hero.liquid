<section
  class="hero hero--{{ section.settings.height }}"
  style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}"
>
  <div class="hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          class: 'hero__image',
          alt: ''
      }}
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn--outline-light" href="{{ section.settings.button2_link | default: routes.root_url }}">
            {{- section.settings.button2_label -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bannière d'accueil",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    {
      "type": "range",
      "id": "overlay",
      "label": "Voile sombre sur l'image",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "select",
      "id": "height",
      "label": "Hauteur",
      "options": [
        { "value": "small", "label": "Compacte" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Grande" }
      ],
      "default": "large"
    },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Parfums en décants" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Essaie avant d'adopter" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Des parfums de créateurs et de niche en 2, 5 ou 10 ml, sans acheter le flacon complet."
    },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Voir les parfums" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button2_label", "label": "Bouton secondaire" },
    { "type": "url", "id": "button2_link", "label": "Lien du bouton secondaire" }
  ],
  "presets": [{ "name": "Bannière d'accueil" }]
}
{% endschema %}
