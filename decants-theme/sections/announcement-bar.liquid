{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="Annonce">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonce",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "Découvre nos décants de 2, 5 et 10 ml"
    },
    { "type": "url", "id": "link", "label": "Lien (facultatif)" }
  ]
}
{% endschema %}
