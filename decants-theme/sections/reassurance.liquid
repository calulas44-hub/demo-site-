<section class="trust">
  <ul class="container trust__list" role="list">
    {%- for block in section.blocks -%}
      <li class="trust__item" {{ block.shopify_attributes }}>
        <span class="trust__icon">{% render 'icon', icon: block.settings.icon %}</span>
        <div>
          {%- if block.settings.title != blank -%}
            <p class="trust__title">{{ block.settings.title }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="trust__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Bandeau de réassurance",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "flask", "label": "Flacon" },
            { "value": "spray", "label": "Vaporisateur" },
            { "value": "truck", "label": "Livraison" },
            { "value": "shield", "label": "Bouclier" },
            { "value": "check", "label": "Coche" }
          ],
          "default": "flask"
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Argument" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "Bandeau de réassurance" }]
}
{% endschema %}
