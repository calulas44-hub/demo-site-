{%- comment -%}
  Icônes SVG en ligne.
  Paramètre : icon (cart, search, menu, close, account, check, shield, truck, flask, spray, plus, minus, instagram, tiktok, facebook)
{%- endcomment -%}
<svg class="icon icon--{{ icon }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'cart' -%}
      <path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6"/><path d="m20 20-4-4"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/>
    {%- when 'check' -%}
      <path d="m5 12 5 5 9-10"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
    {%- when 'flask' -%}
      <path d="M10 3h4M11 3v5l-5 9a3 3 0 0 0 2.6 4.5h6.8A3 3 0 0 0 18 17l-5-9V3"/><path d="M8.5 15h7"/>
    {%- when 'spray' -%}
      <path d="M9 10h6v10a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V10Z"/><path d="M10 10V7h4v3M12 7V4h3M17 4h2M17 6.5h2.5"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'instagram' -%}
      <rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.5"/><path d="M16.8 7.2h.01"/>
    {%- when 'tiktok' -%}
      <path d="M14 4v10a3.5 3.5 0 1 1-3.5-3.5M14 4c.5 2.5 2 4 5 4.2"/>
    {%- when 'facebook' -%}
      <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5"/>
  {%- endcase -%}
</svg>
